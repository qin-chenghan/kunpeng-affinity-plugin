# Interpreter and host interfaces used by the target vLLM container.
PYTHON_BIN=python3
IXSMI_BIN=ixsmi
# The runner exports the resolved path as KUNPENG_AFFINITY_IXSMI during
# controlled vLLM spawn checks.
SYSFS_ROOT=/sys

# Device selection for the read-only Provider probes.
PROBE_DEVICE=0
VISIBILITY_ENV=CUDA_VISIBLE_DEVICES
REORDER_VISIBLE_DEVICES=1,0
SPAWN_VISIBLE_DEVICES=0
# Set this to the comma-separated target GPU BDFs on heterogeneous hosts.
# Empty means candidate discovery across all display/accelerator PCI functions.
AFFINITY_BDFS=

# Plugin configuration used by the controlled spawn checks.
KUNPENG_AFFINITY_MODE=auto
KUNPENG_AFFINITY_PROVIDER=iluvatar-runtime-pci
KUNPENG_AFFINITY_CPU_POLICY=node
KUNPENG_AFFINITY_DIAGNOSTIC_LEVEL=detail
KUNPENG_AFFINITY_VLLM_FORCE_GENERIC=1
VLLM_WORKER_MULTIPROC_METHOD=spawn

# Stage selection. Reorder is skipped automatically when fewer than two GPUs
# are visible. Every enabled stage stops the suite immediately on failure.
RUN_UNIT_TESTS=1
RUN_TOPOLOGY_PROBE=1
RUN_PROVIDER_PROBE=1
RUN_REORDER_PROBE=1
RUN_SOURCE_INSTALL=1
RUN_FORCED_GENERIC_SPAWN=1
RUN_AUTO_FALLBACK_SPAWN=1

# Keep this disabled in a shared or active runtime container. Set it to 1 only
# in a dedicated test container to permit editable install and dummy spawn.
ENABLE_ENVIRONMENT_CHANGES=0

# Empty means /tmp/kunpeng-affinity-validation-<timestamp>-<pid>. An absolute
# path is used as-is; a relative path is resolved from the repository root.
RESULT_DIR=
